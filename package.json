{
    "name": "website",
    "version": "0.0.1",
    "description": "",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "postbuild": "svelte-sitemap",
        "preview": "pnpm run build && wrangler dev",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "gen": "pnpm run gen:cf-types; pnpm run gen:images",
        "gen:cf-types": "wrangler types src/worker-configuration.d.ts && node -e \"require('fs').writeFileSync('.svelte-kit/cloudflare/_worker.d.ts', 'declare const worker: unknown;\\nexport default worker;\\n')\"",
        "gen:images": "tsx ./scripts/gen-images.ts",
        "deploy": "pnpm run build && wrangler deploy"
    },
    "devDependencies": {
        "@catppuccin/tailwindcss": "^1.0.0",
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@poppanator/sveltekit-svg": "^7.0.0",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/enhanced-img": "^1.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.2.4",
        "@types/node": "^24.0.0",
        "@typescript-eslint/eslint-plugin": "^8.44.0",
        "@typescript-eslint/parser": "^8.44.0",
        "bits-ui": "^2.9.9",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-svelte": "^3.5.1",
        "globals": "^17.6.0",
        "lottie-web": "^5.13.0",
        "playwright": "1.60.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.0.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "sharp": "^0.35.0",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.7",
        "svelte-meta-tags": "^5.0.0",
        "svelte-sitemap": "^4.0.0",
        "svgo": "^4.0.0",
        "tailwindcss": "^4.2.4",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "^7.0.0",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.10",
        "vite-imagetools": "^12.0.0",
        "wrangler": "^4.94.0"
    },
    "packageManager": "pnpm@12.11.1"
}
